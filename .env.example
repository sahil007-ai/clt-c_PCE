# Temporary environment template for local development.
# Copy this file to .env and replace the blank values with your real credentials.
# Keep secrets out of version control.

# Optional live-data refresh configuration.
# The app can run from versioned fixtures and cache files when these remain blank.
TARIFF_SOURCE_URL=

# OpenRouteService - route matrix and distance lookups
# Get your key here: https://account.heigit.org/
OPENROUTESERVICE_API_KEY=

# Tavily - web search and live-data refresh
# Get your key here: https://app.tavily.com/
TAVILY_API_KEY=

# OpenRouter - single API key for OpenAI, Gemini, Anthropic, and other model providers
# Get your key here: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LangSmith - optional tracing and observability
# Get your key here: https://smith.langchain.com/settings
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=clt-c-pce

# GitHub - optional repo or API automation
# Get your token here: https://github.com/settings/tokens
GITHUB_TOKEN=

# Supabase - optional database backend
# Get your project URL and anon/service keys here: https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_KEY=

# Direct Postgres connection string (optional)
DATABASE_URL=

# App environment
APP_ENV=development
